# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Bundler installs all gems here (set via `bundle config set --local path`).
# See CLAUDE.md → "Bundler quirk".
/vendor/bundle
# ML model files — too large for git. Deployed via Capistrano linked_dirs;
# seeded onto the VPS once and persisted across releases.
/vendor/models/

# Python bytecode cache
__pycache__/
*.pyc

# Python venvs and logs from /scripts (eval, training, etc.)
/scripts/**/venv/
/scripts/**/*.log

public/downloads/
