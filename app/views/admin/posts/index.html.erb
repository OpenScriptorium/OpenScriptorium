<% content_for :title, "Admin · Posts" %>

<div class="max-w-4xl mx-auto px-5 py-12 font-serif text-[var(--color-ink)]">
  <header class="flex items-end justify-between border-b border-[var(--color-rule)] pb-6 mb-10">
    <div>
      <p class="text-sm uppercase tracking-wide text-[var(--color-ink-soft)]">Admin</p>
      <h1 class="font-serif text-4xl mt-1">Posts</h1>
    </div>
    <%= link_to "New post", new_admin_post_path,
          class: "inline-block px-4 py-2 bg-[var(--color-ink)] text-[var(--color-page)] text-sm rounded hover:opacity-90" %>
  </header>

  <% if notice %>
    <p class="mb-6 text-sm italic text-[var(--color-ink-soft)]"><%= notice %></p>
  <% end %>

  <% if @posts.any? %>
    <table class="w-full text-sm">
      <thead class="text-left text-xs uppercase tracking-wider text-[var(--color-ink-soft)]">
        <tr>
          <th class="py-2">Title</th>
          <th class="py-2">Slug</th>
          <th class="py-2">Status</th>
          <th class="py-2 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--color-rule)]">
        <% @posts.each do |post| %>
          <tr>
            <td class="py-3"><%= post.title %></td>
            <td class="py-3 font-mono text-xs"><%= post.slug %></td>
            <td class="py-3">
              <% if post.published? %>
                <span class="text-xs">published <%= post.published_at.to_date.iso8601 %></span>
              <% elsif post.published_at %>
                <span class="text-xs italic">scheduled <%= post.published_at.iso8601 %></span>
              <% else %>
                <span class="text-xs italic text-[var(--color-ink-soft)]">draft</span>
              <% end %>
            </td>
            <td class="py-3 text-right space-x-3 text-sm">
              <% if post.published? %>
                <%= link_to "View", post_path(post), class: "underline decoration-dotted" %>
              <% end %>
              <%= link_to "Edit", edit_admin_post_path(post), class: "underline decoration-dotted" %>
              <%= button_to "Delete", admin_post_path(post),
                    method: :delete,
                    form: { data: { turbo_confirm: "Delete \"#{post.title}\"?" } },
                    class: "underline decoration-dotted text-red-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="italic text-[var(--color-ink-soft)]">No posts yet.</p>
  <% end %>
</div>
