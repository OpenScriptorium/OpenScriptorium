<%
  def fmt_bytes(b)
    return "0" unless b && b > 0
    units = %w[B KB MB GB TB]
    i = 0
    n = b.to_f
    while n >= 1024 && i < units.size - 1
      n /= 1024
      i += 1
    end
    n >= 100 ? "%.0f #{units[i]}" % n : "%.1f #{units[i]}" % n
  end

  total_db = @stats[:database][:size_bytes]
  total_tables_bytes = @stats[:tables].sum { |t| t[:total_bytes] }
%>

<div class="max-w-5xl mx-auto px-4 py-8 font-mono text-sm">
  <h1 class="text-2xl font-semibold mb-2 font-sans">Database Stats</h1>
  <p class="text-gray-500 dark:text-gray-400 mb-6 font-sans">
    <%= @stats[:database][:name] %> · postgres <%= @stats[:database][:version].to_s.split(" ").first %>
    · cached <%= time_ago_in_words(Time.parse(@stats[:generated_at])) %> ago
  </p>

  <div class="mb-6 p-4 rounded border border-gray-300 dark:border-gray-700">
    <div class="flex justify-between">
      <span class="font-sans text-gray-600 dark:text-gray-400">total database</span>
      <span class="font-semibold"><%= fmt_bytes(total_db) %></span>
    </div>
    <div class="flex justify-between text-xs text-gray-500">
      <span>sum of user tables</span>
      <span><%= fmt_bytes(total_tables_bytes) %></span>
    </div>
  </div>

  <table class="w-full">
    <thead class="border-b-2 border-gray-300 dark:border-gray-700 text-left">
      <tr class="font-sans">
        <th class="py-2 pr-4">table</th>
        <th class="py-2 pr-4 text-right">total</th>
        <th class="py-2 pr-4 text-right">heap</th>
        <th class="py-2 pr-4 text-right">indexes</th>
        <th class="py-2 pr-4 text-right">toast</th>
        <th class="py-2 pr-4 text-right">live rows</th>
        <th class="py-2 pr-4 text-right">dead</th>
      </tr>
    </thead>
    <tbody>
      <% @stats[:tables].each_with_index do |t, idx| %>
        <% pct = total_db > 0 ? (t[:total_bytes] * 100.0 / total_db) : 0 %>
        <tr class="border-b border-gray-200 dark:border-gray-800 align-top">
          <td class="py-2 pr-4">
            <details>
              <summary class="cursor-pointer">
                <span class="font-semibold"><%= t[:name] %></span>
                <span class="text-xs text-gray-500 ml-2"><%= "%.1f%%" % pct %></span>
              </summary>
              <div class="mt-2 ml-4 text-xs">
                <% if t[:indexes].any? %>
                  <div class="text-gray-500 mb-1">indexes:</div>
                  <% t[:indexes].each do |i| %>
                    <div class="flex gap-3 py-0.5">
                      <span class="text-gray-700 dark:text-gray-300 flex-1 truncate"><%= i[:name] %></span>
                      <span class="text-right w-16"><%= fmt_bytes(i[:bytes]) %></span>
                      <span class="text-right w-20 text-gray-500" title="lifetime scans"><%= number_with_delimiter(i[:scans]) %> scans</span>
                    </div>
                  <% end %>
                <% else %>
                  <div class="text-gray-500">no indexes</div>
                <% end %>
              </div>
            </details>
          </td>
          <td class="py-2 pr-4 text-right whitespace-nowrap"><%= fmt_bytes(t[:total_bytes]) %></td>
          <td class="py-2 pr-4 text-right whitespace-nowrap text-gray-600"><%= fmt_bytes(t[:heap_bytes]) %></td>
          <td class="py-2 pr-4 text-right whitespace-nowrap text-gray-600"><%= fmt_bytes(t[:index_bytes]) %></td>
          <td class="py-2 pr-4 text-right whitespace-nowrap text-gray-600"><%= fmt_bytes(t[:toast_bytes]) %></td>
          <td class="py-2 pr-4 text-right whitespace-nowrap text-gray-600"><%= number_with_delimiter(t[:live_rows]) %></td>
          <td class="py-2 pr-4 text-right whitespace-nowrap <%= t[:dead_rows] > 0 ? 'text-yellow-700 dark:text-yellow-400' : 'text-gray-400' %>"><%= number_with_delimiter(t[:dead_rows]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p class="text-xs text-gray-500 mt-6 font-sans">
    Click a table name to expand its index breakdown. Cached for 60 seconds.
  </p>
</div>
