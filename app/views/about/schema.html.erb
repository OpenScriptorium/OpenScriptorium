<% content_for :title, "Schema reference" %>

<div class="max-w-4xl mx-auto px-5 py-12">
  <header class="border-b border-[var(--color-rule)] pb-6 mb-10">
    <p class="text-sm uppercase tracking-wide text-[var(--color-ink-soft)]">About</p>
    <h1 class="font-serif text-4xl text-[var(--color-ink)] mt-1">Schema reference</h1>
    <p class="mt-3 italic text-[var(--color-ink-soft)] font-serif">
      Introspected live from the running app. The
      <%= link_to "architecture overview", about_architecture_path, class: "underline decoration-dotted" %>
      explains how these tables fit together.
    </p>
    <p class="mt-2 text-sm text-[var(--color-ink-soft)] font-serif">
      Notable columns: <code class="font-mono text-xs">works.traditions</code>
      is a string array (GIN-indexed) using the &chi;-prefix tradition
      taxonomy. <code class="font-mono text-xs">pericopes.tradition</code>
      enables tradition-aware section-heading filtering.
      <code class="font-mono text-xs">canonical_refs.ord</code> is
      guaranteed monotonic with hierarchy ordering within each canonical
      work. See the architecture overview for details.
    </p>
  </header>

  <%# Live corpus snapshot %>
  <section class="mb-12">
    <h2 class="font-serif text-2xl text-[var(--color-ink)] border-b border-[var(--color-rule)] pb-2 mb-6">
      Currently in the corpus
    </h2>

    <div class="grid grid-cols-2 sm:grid-cols-5 gap-x-6 gap-y-3 mb-8 text-sm font-serif">
      <% @corpus_totals.each do |key, value| %>
        <div>
          <p class="text-2xl text-[var(--color-ink)] font-mono"><%= number_with_delimiter(value) %></p>
          <p class="text-[var(--color-ink-soft)] uppercase tracking-wide text-xs">
            <%= key.to_s.tr('_', ' ') %>
          </p>
        </div>
      <% end %>
    </div>

    <table class="w-full text-sm font-serif border-collapse">
      <thead>
        <tr class="border-b border-[var(--color-rule)] text-left text-xs uppercase tracking-wide text-[var(--color-ink-soft)]">
          <th class="py-2 pr-4">Work</th>
          <th class="py-2 pr-4">Language</th>
          <th class="py-2 pr-4">License</th>
          <th class="py-2 pr-4 text-right">Units</th>
        </tr>
      </thead>
      <tbody>
        <% @corpus_works.each do |entry| %>
          <% w = entry[:work] %>
          <tr class="border-b border-[var(--color-rule)]">
            <td class="py-2 pr-4">
              <%= link_to w.title, work_path(w.slug), class: "text-[var(--color-link)] hover:underline" %>
            </td>
            <td class="py-2 pr-4 uppercase tracking-wide text-xs text-[var(--color-ink-soft)]">
              <%= w.language %>
            </td>
            <td class="py-2 pr-4 text-[var(--color-ink-soft)]">
              <%= w.license&.name %>
            </td>
            <td class="py-2 pr-4 text-right font-mono"><%= number_with_delimiter(entry[:unit_count]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <% @groups.each do |group_name, models| %>
    <% next if models.empty? %>
    <section class="mb-12">
      <h2 class="font-serif text-2xl text-[var(--color-ink)] border-b border-[var(--color-rule)] pb-2 mb-6">
        <%= group_name %>
      </h2>

      <% models.each do |m| %>
        <article class="mb-8">
          <h3 class="font-serif text-xl text-[var(--color-ink)] mb-1">
            <code class="font-mono"><%= m[:model].name %></code>
            <span class="text-sm text-[var(--color-ink-soft)] font-serif italic">
              · <code class="font-mono"><%= m[:table] %></code>
            </span>
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-1 mt-3">
            <div>
              <h4 class="text-xs uppercase tracking-wide text-[var(--color-ink-soft)] mb-1">Columns</h4>
              <ul class="text-sm font-mono leading-tight">
                <% m[:columns].each do |c| %>
                  <li>
                    <span class="text-[var(--color-ink)]"><%= c.name %></span>
                    <span class="text-[var(--color-ink-soft)]">: <%= c.sql_type %></span>
                    <% unless c.null %>
                      <span class="text-[var(--color-accent)]">·NOT NULL</span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>

            <div>
              <h4 class="text-xs uppercase tracking-wide text-[var(--color-ink-soft)] mb-1">Associations</h4>
              <ul class="text-sm font-mono leading-tight">
                <% m[:associations].each do |a| %>
                  <li>
                    <span class="text-[var(--color-ink-soft)]"><%= a.macro %></span>
                    <span class="text-[var(--color-ink)]">:<%= a.name %></span>
                    <% if a.options[:class_name] %>
                      <span class="text-[var(--color-ink-soft)]"> → <%= a.options[:class_name] %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </article>
      <% end %>
    </section>
  <% end %>
</div>
