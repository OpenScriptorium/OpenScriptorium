<header class="border-b border-[var(--color-rule)] bg-[var(--color-page)] sticky top-0 z-10"
        data-controller="mobile-menu">
  <div class="max-w-6xl mx-auto px-5 h-14 flex items-center justify-between gap-x-4">
    <%# Brand %>
    <%= link_to root_path, class: "flex items-center gap-x-2 group flex-shrink-0", "aria-label": "Open Scriptorium home" do %>
      <span aria-hidden="true"><%= inline_svg "dropcap-S", class: "dropcap-nav" %></span>
      <span class="font-serif text-lg text-[var(--color-ink)] tracking-tight hidden sm:inline" aria-hidden="true">
        Open Scriptorium
      </span>
    <% end %>

    <%# Search input — will be enabled when search ships %>
    <%# <form action="search_path" ... /> %>

    <%# Desktop nav — hidden on mobile %>
    <nav aria-label="Main" class="hidden sm:flex items-center gap-x-4 text-sm font-serif flex-shrink-0">
      <%= link_to "Read",         works_path,
            class: "px-2 py-1 text-[var(--color-ink)] hover:text-[var(--color-link)]" %>
      <%= link_to "Scholars",     appeal_to_scholars_path,
            class: "px-2 py-1 text-[var(--color-ink)] hover:text-[var(--color-link)]" %>
      <%= link_to "Publishers",   appeal_to_publishers_path,
            class: "px-2 py-1 text-[var(--color-ink)] hover:text-[var(--color-link)]" %>
      <%= link_to "Principles",   principles_path,
            class: "px-2 py-1 text-[var(--color-ink)] hover:text-[var(--color-link)]" %>
      <%= link_to "Architecture", about_architecture_path,
            class: "px-2 py-1 text-[var(--color-ink)] hover:text-[var(--color-link)] hidden md:inline" %>
      <%= link_to "Schema",       about_schema_path,
            class: "px-2 py-1 text-[var(--color-ink)] hover:text-[var(--color-link)] hidden md:inline" %>
      <%= link_to "API",          downloads_path,
            class: "px-2 py-1 text-[var(--color-ink)] hover:text-[var(--color-link)]" %>

      <% if authenticated? %>
        <%= button_to "Sign out", session_path, method: :delete,
              class: "px-2 py-1 text-[var(--color-ink-soft)] hover:text-[var(--color-link)] inline-block",
              form: { class: "inline" } %>
      <% else %>
        <%= link_to "Sign in", new_session_path,
              class: "px-2 py-1 text-[var(--color-ink-soft)] hover:text-[var(--color-link)]" %>
      <% end %>
    </nav>

    <%# Mobile hamburger — visible only on small screens %>
    <button type="button"
            class="sm:hidden p-2 text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]"
            data-action="click->mobile-menu#toggle"
            aria-label="Menu"
            aria-expanded="false"
            data-mobile-menu-target="button">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"
           data-mobile-menu-target="iconOpen">
        <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" viewBox="0 0 20 20" fill="currentColor"
           data-mobile-menu-target="iconClose">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>

  <%# Mobile menu panel — slides down below the navbar %>
  <nav aria-label="Mobile navigation"
       class="hidden sm:hidden border-t border-[var(--color-rule)] bg-[var(--color-page)]"
       data-mobile-menu-target="panel">
    <div class="max-w-6xl mx-auto px-5 py-3 flex flex-col gap-y-1 font-serif text-sm">
      <%= link_to "Read",         works_path,
            class: "px-3 py-2 rounded text-[var(--color-ink)] hover:bg-[var(--color-rule)]/50" %>
      <%= link_to "Scholars",     appeal_to_scholars_path,
            class: "px-3 py-2 rounded text-[var(--color-ink)] hover:bg-[var(--color-rule)]/50" %>
      <%= link_to "Publishers",   appeal_to_publishers_path,
            class: "px-3 py-2 rounded text-[var(--color-ink)] hover:bg-[var(--color-rule)]/50" %>
      <%= link_to "Principles",   principles_path,
            class: "px-3 py-2 rounded text-[var(--color-ink)] hover:bg-[var(--color-rule)]/50" %>
      <%= link_to "Architecture", about_architecture_path,
            class: "px-3 py-2 rounded text-[var(--color-ink)] hover:bg-[var(--color-rule)]/50" %>
      <%= link_to "Schema",       about_schema_path,
            class: "px-3 py-2 rounded text-[var(--color-ink)] hover:bg-[var(--color-rule)]/50" %>
      <%= link_to "API",          downloads_path,
            class: "px-3 py-2 rounded text-[var(--color-ink)] hover:bg-[var(--color-rule)]/50" %>
      <hr class="border-[var(--color-rule)] my-1">
      <% if authenticated? %>
        <%= button_to "Sign out", session_path, method: :delete,
              class: "px-3 py-2 rounded text-left text-[var(--color-ink-soft)] hover:bg-[var(--color-rule)]/50",
              form: { class: "w-full" } %>
      <% else %>
        <%= link_to "Sign in", new_session_path,
              class: "px-3 py-2 rounded text-[var(--color-ink-soft)] hover:bg-[var(--color-rule)]/50" %>
      <% end %>
    </div>
  </nav>
</header>
