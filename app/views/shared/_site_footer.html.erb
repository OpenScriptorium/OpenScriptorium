<footer class="border-t border-[var(--color-rule)] mt-16 py-6">
  <div class="max-w-6xl mx-auto px-5 flex flex-wrap items-center justify-between gap-y-3 gap-x-6 text-sm text-[var(--color-ink-soft)] font-serif">
    <p>
      Open Scriptorium &middot; This is
      <a href="https://www.gnu.org/philosophy/free-sw.en.html"
         class="underline decoration-dotted hover:text-[var(--color-link)]">free</a>.
    </p>

    <%# Reading theme slider — interpolates page/ink CSS variables across
        a 0..100 range with stops at black-on-white, Solarized Light,
        Solarized Dark, and white-on-black. Persisted in a cookie. %>
    <div data-controller="reading-theme"
         class="flex items-center gap-x-3 text-xs">
      <span class="italic" aria-hidden="true">light</span>
      <input type="range" min="0" max="100" step="1" value="0"
             aria-label="Reading theme"
             data-reading-theme-target="slider"
             data-action="input->reading-theme#update"
             class="w-32 sm:w-40 accent-[var(--color-link)] cursor-pointer">
      <span class="italic" aria-hidden="true">dark</span>
    </div>

    <p class="text-xs italic">
      <a href="https://git.sr.ht/~sethkush/openscriptorium" class="hover:text-[var(--color-link)]">Source on sr.ht</a>
    </p>
  </div>
</footer>
