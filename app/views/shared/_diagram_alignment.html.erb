<%# Many-to-many alignment group: Hebrew (3 words) → English (5 words),
    all bound by a single alignment_group "id". %>

<svg viewBox="0 0 760 320" xmlns="http://www.w3.org/2000/svg"
     class="w-full h-auto"
     role="img"
     aria-labelledby="diagram-alignment-title">
  <title id="diagram-alignment-title">Macula-style alignment groups</title>

  <style>
    .heading       { font: bold 13px sans-serif; fill: var(--color-ink); }
    .label         { font: italic 12px serif; fill: var(--color-ink-soft); }
    .word-source   { fill: color-mix(in oklab, var(--color-link) 15%, var(--color-page)); stroke: var(--color-link); stroke-width: 1.5; }
    .word-target   { fill: color-mix(in oklab, var(--color-ink) 6%, var(--color-page)); stroke: var(--color-ink); stroke-width: 1.5; }
    .word-text     { font: 14px serif; fill: var(--color-ink); }
    .word-text-he  { font: 18px serif; fill: var(--color-ink); }
    .group-box     { fill: none; stroke: var(--color-link); stroke-width: 1.5; stroke-dasharray: 4 3; }
    .conn          { stroke: var(--color-ink-soft); stroke-width: 1; fill: none; }
  </style>

  <text x="20" y="32" class="heading">alignment_group  ·  type=literal</text>
  <text x="20" y="48" class="label">a single logical alignment with many source and target words</text>

  <!-- Source row (Hebrew, RTL) -->
  <text x="20" y="100" class="label">source · WLC Hebrew</text>

  <!-- Three Hebrew words, right-to-left visually but left-to-right SVG positions -->
  <g>
    <rect x="540" y="115" width="160" height="40" rx="4" class="word-source"/>
    <text x="620" y="142" text-anchor="middle" class="word-text-he">בְּרֵאשִׁית</text>

    <rect x="370" y="115" width="160" height="40" rx="4" class="word-source"/>
    <text x="450" y="142" text-anchor="middle" class="word-text-he">בָּרָא</text>

    <rect x="200" y="115" width="160" height="40" rx="4" class="word-source"/>
    <text x="280" y="142" text-anchor="middle" class="word-text-he">אֱלֹהִים</text>
  </g>

  <!-- Target row (English) -->
  <text x="20" y="220" class="label">target · BSB English</text>

  <g>
    <rect x="60"  y="235" width="80" height="34" rx="4" class="word-target"/>
    <text x="100" y="258" text-anchor="middle" class="word-text">In</text>

    <rect x="150" y="235" width="80" height="34" rx="4" class="word-target"/>
    <text x="190" y="258" text-anchor="middle" class="word-text">the</text>

    <rect x="240" y="235" width="120" height="34" rx="4" class="word-target"/>
    <text x="300" y="258" text-anchor="middle" class="word-text">beginning</text>

    <rect x="380" y="235" width="80" height="34" rx="4" class="word-target"/>
    <text x="420" y="258" text-anchor="middle" class="word-text">God</text>

    <rect x="470" y="235" width="120" height="34" rx="4" class="word-target"/>
    <text x="530" y="258" text-anchor="middle" class="word-text">created</text>
  </g>

  <!-- Group dashed border around everything -->
  <rect x="40" y="105" width="680" height="180" rx="8" class="group-box"/>

  <!-- Connectors: בְּרֵאשִׁית → "In", "the", "beginning" -->
  <path d="M 620 155 Q 360 195, 100 235" class="conn"/>
  <path d="M 620 155 Q 405 195, 190 235" class="conn"/>
  <path d="M 620 155 Q 460 195, 300 235" class="conn"/>

  <!-- בָּרָא → "created" -->
  <path d="M 450 155 Q 490 195, 530 235" class="conn"/>

  <!-- אֱלֹהִים → "God" -->
  <path d="M 280 155 Q 350 195, 420 235" class="conn"/>

  <text x="380" y="305" text-anchor="middle" class="label">
    1 group, 3 source words, 5 target words — m:n alignment in a single row.
  </text>
</svg>
