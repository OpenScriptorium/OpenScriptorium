<%# Number line of canonical_refs.ord with overlapping range bars and a
    "query verse" highlighted in red. Multiple cross-refs of different
    sizes (verse, range, whole book) all touching the query position. %>

<svg viewBox="0 0 760 320" xmlns="http://www.w3.org/2000/svg"
     class="w-full h-auto"
     role="img"
     aria-labelledby="diagram-xrefs-title">
  <title id="diagram-xrefs-title">Cross-references via int4range overlap</title>

  <style>
    .axis        { stroke: var(--color-ink); stroke-width: 1.5; }
    .tick        { stroke: var(--color-ink); stroke-width: 1; }
    .tick-label  { font: 11px ui-monospace, monospace; fill: var(--color-ink-soft); }
    .label       { font: italic 12px serif; fill: var(--color-ink-soft); }
    .heading     { font: bold 13px sans-serif; fill: var(--color-ink); }
    .body        { font: 12px serif; fill: var(--color-ink); }
    .range-bar   { stroke: var(--color-ink); stroke-width: 8; stroke-linecap: round; }
    .range-label { font: 11px serif; fill: var(--color-ink); }
    .marker      { stroke: var(--color-link); stroke-width: 2; }
    .marker-label{ font: bold 12px serif; fill: var(--color-link); }
  </style>

  <text x="20" y="32" class="heading">canonical_refs.ord (Genesis)</text>
  <text x="20" y="48" class="label">a sequential integer per verse</text>

  <!-- Number line at y=100 -->
  <line x1="60" y1="100" x2="720" y2="100" class="axis"/>
  <% (0..15).each do |i|
       x = 60 + i * 44
       label = case i
               when 0  then "1"
               when 5  then "6"
               when 10 then "11"
               when 15 then "16"
               end %>
    <line x1="<%= x %>" y1="95" x2="<%= x %>" y2="105" class="tick"/>
    <% if label %>
      <text x="<%= x %>" y="120" text-anchor="middle" class="tick-label"><%= label %></text>
    <% end %>
  <% end %>

  <text x="60" y="135" class="label">Gen 1:1</text>
  <text x="720" y="135" text-anchor="end" class="label">Gen 1:16</text>

  <!-- Query marker on ord = 6 -->
  <line x1="<%= 60 + 5 * 44 %>" y1="80" x2="<%= 60 + 5 * 44 %>" y2="115" class="marker"/>
  <text x="<%= 60 + 5 * 44 %>" y="74" text-anchor="middle" class="marker-label">query: ord = 6</text>

  <!-- Range bars below -->
  <text x="20" y="170" class="heading">overlapping cross_references</text>

  <!-- Range 1: a single verse hit (ord 6) -->
  <line x1="<%= 60 + 5 * 44 %>" y1="195" x2="<%= 60 + 6 * 44 %>" y2="195" class="range-bar"/>
  <text x="<%= 60 + 16 * 44 + 0 %>" y="199" class="range-label">single verse → quoted by Heb 11:3</text>

  <!-- Range 2: a chapter hit (ord 1..32) -->
  <line x1="<%= 60 + 0 * 44 %>" y1="225" x2="<%= 60 + 15 * 44 %>" y2="225" class="range-bar"/>
  <text x="<%= 60 + 16 * 44 + 0 %>" y="229" class="range-label">whole chapter → John 1:1-3 alludes</text>

  <!-- Range 3: small range (ord 4..8) -->
  <line x1="<%= 60 + 3 * 44 %>" y1="255" x2="<%= 60 + 7 * 44 %>" y2="255" class="range-bar"/>
  <text x="<%= 60 + 16 * 44 + 0 %>" y="259" class="range-label">verse range → 2 Cor 4:6</text>

  <!-- All three intersect query=6 -->
  <line x1="<%= 60 + 5 * 44 %>" y1="180" x2="<%= 60 + 5 * 44 %>" y2="270" class="marker" stroke-dasharray="2 3"/>

  <text x="380" y="305" text-anchor="middle" class="body">
    <tspan font-family="ui-monospace, monospace">source_range &amp;&amp; int4range(6, 7)</tspan>
    matches all three with one indexed query.
  </text>
</svg>
