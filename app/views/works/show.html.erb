<% content_for :title, @work.title %>

<div class="max-w-3xl mx-auto py-12">
  <header class="border-b border-[var(--color-rule)] pb-6 mb-10">
    <p class="text-sm text-[var(--color-ink-soft)] uppercase tracking-wide">
      <%= @work.work_type_label %>
    </p>
    <h1 class="font-serif text-4xl text-[var(--color-ink)] mt-1"><%= @work.title %></h1>
    <% if @work.native_title.present? %>
      <p class="text-2xl font-serif text-[var(--color-ink-soft)] mt-2" lang="<%= @work.language %>"><%= @work.native_title %></p>
    <% end %>

    <% if @work.description.present? %>
      <p class="mt-4 text-[var(--color-ink)] font-serif leading-relaxed"><%= @work.description %></p>
    <% end %>

    <p class="mt-4 text-sm text-[var(--color-ink-soft)]">
      <% if @work.language.present? %><span class="uppercase tracking-wide"><%= @work.language %></span> · <% end %>
      <%= @work.license.name %>
      <% if @work.source_url.present? %>
        · <%= link_to "source", @work.source_url, class: "underline decoration-dotted" %>
      <% end %>
    </p>
  </header>

  <h2 class="font-serif text-xl text-[var(--color-ink)] mb-4">Books</h2>

  <% grouped = @canonical_works.group_by(&:testament)
     ot          = grouped["ot"]           || []
     deuterocanon = grouped["deuterocanon"] || []
     nt          = grouped["nt"]           || []
     rest        = @canonical_works.reject { |cw| %w[ot nt deuterocanon].include?(cw.testament) } %>

  <% is_jewish = @work.traditions&.any? { |t| t.start_with?("ש") }
     ot_label = is_jewish ? "Hebrew Bible" : "Hebrew Bible / Old Testament" %>

  <% [[ot_label,                                 ot],
      ["Deuterocanon / Apocrypha",              deuterocanon],
      ["New Testament",                         nt],
      ["Other",                                  rest]].each do |label, books| %>
    <% next if books.empty? %>
    <h3 class="text-sm uppercase tracking-wide text-[var(--color-ink-soft)] mt-6 mb-2"><%= label %></h3>
    <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-1 font-serif">
      <% books.each do |cw| %>
        <li>
          <% book_name = @work.language == "en" ? cw.slug.titleize.gsub("-", " ") : cw.display_title %>
          <%= link_to book_name, reader_book_path(@work.slug, cw.slug),
                class: "text-[var(--color-link)] hover:underline" %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
