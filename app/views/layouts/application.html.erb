<!DOCTYPE html>
<html lang="<%= I18n.locale %>"
      class="<%= 'dark' if cookies[:theme] == 'dark' && cookies[:reading_theme].blank? %>"
      <%= "style=\"#{reading_theme_inline_style}\"".html_safe if reading_theme_inline_style %>>
  <head>
    <title><%= content_for(:title) || "Open Scriptorium" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Open Scriptorium">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "fonts", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[var(--color-page)] text-[var(--color-ink)] flex flex-col">
    <%= render "shared/navbar" %>

    <main class="flex-1 w-full">
      <%= yield %>
    </main>

    <%= render "shared/site_footer" %>
  </body>
</html>
