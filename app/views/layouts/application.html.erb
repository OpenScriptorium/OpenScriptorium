<!--
  "Information is power. But like all power, there are those who want
  to keep it for themselves."
                                        — Aaron Swartz (1986–2013)
-->
<!DOCTYPE html>
<html lang="<%= I18n.locale %>"
      class="<%= 'dark' if cookies[:theme] == 'dark' && cookies[:reading_theme].blank? %>"
      <%= "style=\"#{reading_theme_inline_style}\"".html_safe if reading_theme_inline_style %>>
  <head>
    <title><%= content_for(:title) || "Open Scriptorium" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Open Scriptorium">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Preload the primary body font so the browser fetches it before parsing CSS.
        This cuts First Contentful Paint on mobile by ~3-4 seconds. %>
    <link rel="preload" as="font" type="font/woff2" href="<%= asset_path("CharisSIL-Regular.woff2") %>" crossorigin>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <%# Fonts CSS is tiny (~3KB) and needed for first paint — keep blocking %>
    <%= stylesheet_link_tag "fonts", "data-turbo-track": "reload" %>

    <%# Tailwind CSS — load async with print/onload trick to avoid blocking FCP.
        The noscript fallback ensures it loads without JS. %>
    <link rel="stylesheet" href="<%= asset_path("tailwind.css") %>" media="print" onload="this.media='all'" data-turbo-track="reload">
    <noscript><%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %></noscript>

    <%# Critical inline styles for above-the-fold content before Tailwind loads %>
    <style>
      body { font-family: "Charis SIL", Georgia, serif; margin: 0; }
      .min-h-screen { min-height: 100vh; }
      .flex { display: flex; }
      .flex-col { flex-direction: column; }
      .flex-1 { flex: 1 1 0%; }
      .items-center { align-items: center; }
      .justify-between { justify-content: space-between; }
      .sticky { position: sticky; }
      .top-0 { top: 0; }
      .z-10 { z-index: 10; }
      .mx-auto { margin-left: auto; margin-right: auto; }
      .max-w-6xl { max-width: 72rem; }
      .px-5 { padding-left: 1.25rem; padding-right: 1.25rem; }
      .h-14 { height: 3.5rem; }
      .hidden { display: none; }
      .border-b { border-bottom-width: 1px; border-bottom-style: solid; }
    </style>

    <link rel="jslicense" href="/jslicense">
  </head>

  <body class="min-h-screen bg-[var(--color-page)] text-[var(--color-ink)] flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-[var(--color-page)] focus:text-[var(--color-link)] focus:p-4 focus:rounded focus:ring-2 focus:ring-[var(--color-link)]">Skip to content</a>
    <%= render "shared/navbar" %>

    <main id="main-content" tabindex="-1" class="flex-1 w-full">
      <%= yield %>
    </main>

    <%= render "shared/site_footer" %>

    <%# JS at end of body — doesn't block first paint %>
    <%= javascript_importmap_tags %>
  </body>
</html>
