<% content_for :title, "#{@primary_canonical_work.display_title} #{@range_label} — parallel" %>

<div class="max-w-7xl mx-auto px-5 py-12">
  <header class="border-b border-[var(--color-rule)] pb-6 mb-6">
    <p class="text-sm uppercase tracking-wide text-[var(--color-ink-soft)]">Parallel</p>
    <h1 class="font-serif text-3xl text-[var(--color-ink)] mt-1">
      <%= @primary_canonical_work.display_title %> <%= @range_label %>
    </h1>
    <p class="mt-2 text-sm text-[var(--color-ink-soft)] font-serif">
      <%= @works.map(&:title).join(" · ") %>
    </p>
  </header>

  <%# ============================================================
    # Column header row — each column has its own <select> picker.
    # Changing any picker re-navigates with the new works list, no
    # submit button. The trailing "+ Add column" picker appends a
    # new column when the user chooses a work in it.
    # The grid has one extra trailing column to host the +Add picker
    # without affecting row alignment.
    # ============================================================ %>
  <% grid_style = "grid-template-columns: 4rem repeat(#{@works.size}, minmax(0, 1fr)) 9rem;" %>
  <% picker_options = @available_works.map { |w| [w.title, w.slug] } %>

  <div data-controller="parallel-picker"
       class="grid gap-x-6 mb-4 items-end"
       style="<%= grid_style %>">
    <div></div>
    <% @works.each_with_index do |w, idx| %>
      <div class="font-serif">
        <%= select_tag "col_#{idx}",
              options_for_select(picker_options + [["(remove this column)", "__remove__"]], w.slug),
              class: "parallel-col w-full text-sm bg-transparent border-0 border-b border-[var(--color-rule)] " \
                     "py-1 px-0 font-serif text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-link)]",
              "data-action": "change->parallel-picker#update" %>
        <% if idx == 0 %>
          <p class="text-xs text-[var(--color-ink-soft)] italic mt-1">primary &middot; row anchor</p>
        <% end %>
      </div>
    <% end %>

    <%# +Add column — blank first option, picking a work appends it %>
    <div>
      <%= select_tag "col_add",
            options_for_select([["+ add column", ""]] + picker_options),
            class: "parallel-col w-full text-sm bg-transparent border-0 border-b border-dashed " \
                   "border-[var(--color-rule)] py-1 px-0 font-serif text-[var(--color-ink-soft)] " \
                   "italic focus:outline-none focus:border-[var(--color-link)]",
            "data-action": "change->parallel-picker#update" %>
    </div>
  </div>

  <% last_unit_id = {} %>
  <% @rows.each do |row| %>
    <% ref = row[:ref] %>
    <div class="grid gap-x-6 border-b border-[var(--color-rule)] py-4 align-top"
         style="<%= grid_style %>">

      <%# Verse-number gutter, anchored to the primary canonical_ref %>
      <div class="text-xs text-[var(--color-ink-soft)] font-sans pt-1">
        <%= link_to "#{ref.hierarchy[0]}:#{ref.hierarchy[1]}",
              parallel_verse_path(@book_slug, ref.hierarchy[0], ref.hierarchy[1],
                                  works: @selected_slugs.join(",")),
              class: "hover:underline decoration-dotted" %>
      </div>

      <% @works.each do |w| %>
        <% units = row[:cells][w.id] || [] %>
        <div class="<%= scripture_classes_for(w) %>"
             lang="<%= w.language %>"
             dir="<%= rtl_work?(w) ? 'rtl' : 'ltr' %>">
          <% if units.empty? %>
            <span class="text-[var(--color-ink-soft)]">&mdash;</span>
          <% else %>
            <% rendered_anything = false %>
            <% units.each do |u| %>
              <%# de-dupe merges: same secondary unit echoed across N primary rows %>
              <% next if last_unit_id[w.id] == u.id %>
              <% last_unit_id[w.id] = u.id %>
              <% rendered_anything = true %>
              <% u_notes = u.work_unit_notes.to_a.sort_by(&:position_in_unit) %>
              <span class="block">
                <% if u.canonical_ref.hierarchy != ref.hierarchy %>
                  <sup class="text-xs text-[var(--color-ink-soft)] font-sans align-super mr-1" dir="ltr">
                    <%= u.canonical_ref.hierarchy[0] %>:<%= u.canonical_ref.hierarchy[1] %>
                  </sup>
                <% end %><%= render_verse_body_with_tooltips(u, u_notes) %>
              </span>
            <% end %>
            <% unless rendered_anything %>
              <span class="text-[var(--color-ink-soft)] text-xs italic" dir="ltr">↑ merged</span>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%# Spacer matching the trailing +Add column in the header row %>
      <div></div>
    </div>
  <% end %>

  <%# Chapter navigation only for the bare chapter view %>
  <% if @range_kind == :chapter %>
    <% chapter = params[:chapter].to_i %>
    <nav class="mt-10 flex justify-between text-sm font-serif">
      <% if chapter > 1 %>
        <%= link_to "← Chapter #{chapter - 1}",
              parallel_chapter_path(@book_slug, chapter - 1, works: @selected_slugs.join(",")),
              class: "text-[var(--color-link)] hover:underline" %>
      <% else %><span></span><% end %>
      <%= link_to "Chapter #{chapter + 1} →",
            parallel_chapter_path(@book_slug, chapter + 1, works: @selected_slugs.join(",")),
            class: "text-[var(--color-link)] hover:underline" %>
    </nav>
  <% end %>

  <footer class="mt-12 pt-6 border-t border-[var(--color-rule)] text-xs text-[var(--color-ink-soft)] space-y-1">
    <% @works.each do |w| %>
      <p>
        <%= w.title %>
        <% if w.license %> · <%= w.license.name %><% end %>
      </p>
    <% end %>
  </footer>
</div>
