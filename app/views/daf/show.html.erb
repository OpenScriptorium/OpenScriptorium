<% content_for :title, "#{@canonical_work.title} #{@daf_label} — Talmud Bavli" %>

<div class="max-w-6xl mx-auto px-5 py-12" data-controller="daf-layout">
  <nav aria-label="Breadcrumb" class="text-sm text-[var(--color-ink-soft)] mb-4">
    <ol class="flex flex-wrap items-center gap-x-1 list-none p-0 m-0">
      <li><%= link_to "Talmud", works_path, class: "hover:underline" %></li>
      <li><span aria-hidden="true">&raquo;</span></li>
      <li><%= link_to @canonical_work.title, reader_book_path(@gemara_work.slug, @canonical_work.slug), class: "hover:underline" %></li>
      <li><span aria-hidden="true">&raquo;</span></li>
      <li aria-current="page"><%= @daf_label %></li>
    </ol>
  </nav>

  <header class="border-b border-[var(--color-rule)] pb-6 mb-10 text-center">
    <p class="text-sm uppercase tracking-wide text-[var(--color-ink-soft)]">Talmud Bavli</p>
    <h1 class="font-hebrew text-3xl text-[var(--color-ink)] mt-1" lang="he" dir="rtl">
      <%= @canonical_work.title %>
    </h1>
    <p class="text-lg text-[var(--color-ink-soft)] font-serif mt-1">
      Daf <%= @daf_label %>
    </p>
  </header>

  <% all_rashi = @segments.flat_map { |s| s[:rashi] } %>
  <% all_tosafot = @segments.flat_map { |s| s[:tosafot] } %>

  <%# Force font preload — invisible text triggers browser to download fonts %>
  <span style="font-family:Vilna;position:absolute;opacity:0;">א</span>
  <span style="font-family:Rashi;position:absolute;opacity:0;">א</span>

  <%# daf-renderer target container %>
  <div id="daf-container" style="max-width:56rem;margin:0 auto;position:relative;"></div>

  <%# Simple view (shown when Vilna is toggled off) %>
  <div id="daf-simple" class="font-hebrew max-w-3xl mx-auto" dir="rtl" lang="arc" style="display:none;">
    <% @segments.each do |seg| %>
      <p class="mb-3 leading-relaxed" style="font-family:Vilna,serif;font-size:15px;line-height:24px;<%= 'font-weight:bold;' if seg[:mishnah] %>">
        <% if seg[:mishnah] %><span style="color:var(--color-accent);font-weight:700;">מתני׳</span> <% end %>
        <%= seg[:gemara].body %>
      </p>
    <% end %>
  </div>

  <%# Hidden data for JS to read %>
  <script type="application/json" id="daf-data"><%= {
    gemara: @segments.map { |s|
      body = s[:gemara].body
      if s[:mishnah]
        "<b>מתני׳</b> #{body}"
      else
        body
      end
    }.join(" "),
    rashi: all_rashi.map { |e|
      dh, body = split_commentary(e.body)
      dh ? "<b>#{dh}</b> – #{body}" : e.body
    }.join(" "),
    tosafot: all_tosafot.map { |e|
      dh, body = split_commentary(e.body)
      dh ? "<b>#{dh}</b> – #{body}" : e.body
    }.join(" ")
  }.to_json.html_safe %></script>

  <nav aria-label="Daf navigation" class="mt-10 flex justify-between text-sm font-serif">
    <% if @prev_daf %>
      <%= link_to "← #{daf_label(*@prev_daf)}",
            daf_nav_path(@gemara_work.slug, @canonical_work.slug, *@prev_daf),
            class: "text-[var(--color-link)] hover:underline" %>
    <% else %><span></span><% end %>

    <% if @next_daf %>
      <%= link_to "#{daf_label(*@next_daf)} →",
            daf_nav_path(@gemara_work.slug, @canonical_work.slug, *@next_daf),
            class: "text-[var(--color-link)] hover:underline" %>
    <% else %><span></span><% end %>
  </nav>

  <footer class="mt-16 pt-6 border-t border-[var(--color-rule)] text-xs text-[var(--color-ink-soft)] space-y-2">
    <% layout_mode = cookies[:daf_layout].to_s %>
    <% vilna_on = layout_mode != "simple" %>
    <div class="flex items-center gap-x-3 font-serif">
      <label class="cursor-pointer flex items-center gap-1.5">
        <input type="checkbox" name="daf_layout"
               <%= "checked" if vilna_on %>
               data-action="change->daf-layout#toggle"
               class="accent-[var(--color-ink)]" />
        <span>Vilna layout</span>
      </label>
    </div>
    <p>
      <%= @gemara_work.title %> · <%= @gemara_work.license.name %>
      <% if @rashi_work %> · Rashi (<%= @rashi_work.license.name %>)<% end %>
      <% if @tosafot_work %> · Tosafot (<%= @tosafot_work.license.name %>)<% end %>
    </p>
  </footer>
</div>
