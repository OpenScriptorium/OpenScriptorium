<% content_for :title, "#{@canonical_work.title} — #{@work.title}" %>

<div class="max-w-3xl mx-auto py-12">
  <nav class="text-sm text-[--color-ink-soft] mb-4">
    <%= link_to @work.title, work_path(@work.slug), class: "hover:underline" %>
    &raquo;
    <span><%= @canonical_work.title %></span>
  </nav>

  <header class="border-b border-[--color-rule] pb-6 mb-8">
    <h1 class="font-serif text-4xl text-[--color-ink]"><%= @canonical_work.title %></h1>
    <% if @canonical_work.native_title.present? %>
      <p class="text-2xl font-serif text-[--color-ink-soft] mt-2" lang="<%= @work.language %>">
        <%= @canonical_work.native_title %>
      </p>
    <% end %>
    <p class="text-sm text-[--color-ink-soft] mt-3">
      <%= @work.title %>
    </p>
  </header>

  <h2 class="font-serif text-xl text-[--color-ink] mb-3">Chapters</h2>
  <ul class="flex flex-wrap gap-2">
    <% @chapters.each do |ch| %>
      <li>
        <%= link_to ch, reader_chapter_path(@work.slug, @canonical_work.slug, ch),
              class: "inline-block px-3 py-1 border border-[--color-rule] rounded font-serif text-[--color-link] hover:bg-[--color-rule]" %>
      </li>
    <% end %>
  </ul>
</div>
