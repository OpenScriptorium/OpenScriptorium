<%# Inline cross-references for a single verse.
    Receives:
      verse_unit: WorkUnit (the verse being annotated)

    Renders nothing when the user has no xref datasets selected, or
    when no cross-references match this verse for the selected
    datasets — the default reader view stays uncluttered. %>
<% xrefs = cross_references_for(verse_unit.canonical_ref) %>
<% if xrefs.any? %>
  <p class="verse-xrefs mt-1 ml-6 text-xs text-[var(--color-ink-soft)] font-serif italic">
    <span class="not-italic mr-1" aria-hidden="true">↪</span>
    <% xrefs.each_with_index do |xref, i| %><%= "·" if i > 0 %>
      <%= link_to format_xref_target(xref), xref_target_path(xref),
            class: "underline decoration-dotted hover:text-[var(--color-link)] not-italic",
            title: "From #{xref_dataset_label(xref.source_dataset)}" %>
    <% end %>
  </p>
<% end %>
