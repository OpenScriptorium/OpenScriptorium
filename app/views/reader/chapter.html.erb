<% content_for :title, "#{@canonical_work.display_title} #{@chapter} — #{@work.title}" %>
<% preload_xrefs_for_chapter!(@verses) %>

<% has_notes = any_notes?(@verses) %>
<% wrapper_max = has_notes ? "max-w-5xl" : "max-w-3xl" %>

<div class="<%= wrapper_max %> mx-auto px-5 py-12">
  <nav aria-label="Breadcrumb" class="text-sm text-[var(--color-ink-soft)] mb-4">
    <ol class="flex flex-wrap items-center gap-x-1 list-none p-0 m-0">
      <li><%= link_to @work.title, work_path(@work.slug), class: "hover:underline" %></li>
      <li><span aria-hidden="true">&raquo;</span></li>
      <li><%= link_to @canonical_work.display_title, reader_book_path(@work.slug, @canonical_work.slug), class: "hover:underline" %></li>
      <li><span aria-hidden="true">&raquo;</span></li>
      <li aria-current="page">Chapter <%= @chapter %></li>
    </ol>
  </nav>

  <header class="border-b border-[var(--color-rule)] pb-6 mb-10">
    <h1 class="font-serif text-3xl text-[var(--color-ink)]">
      <%= @canonical_work.display_title %> <%= @chapter %>
    </h1>
    <% display_native = @canonical_work.native_title_for(@work.language) %>
    <% if display_native.present? && display_native != @canonical_work.display_title %>
      <p class="text-xl font-serif text-[var(--color-ink-soft)] mt-1" lang="<%= @work.language %>">
        <%= display_native %> <%= @chapter %>
      </p>
    <% end %>
    <p class="mt-2 text-sm font-serif">
      <%= link_to "Read in parallel →",
            parallel_chapter_path(@canonical_work.book_key, @chapter,
                                  works: parallel_works_param(@work)),
            class: "text-[var(--color-link)] hover:underline" %>
    </p>
  </header>

  <%# When the work has marginal notes (KJV, currently), use a two-column
      layout: prose on the left, notes in a narrow margin column on the
      right, vertically aligned to the verse they annotate. The
      annotation-highlight Stimulus controller pairs anchor phrases with
      their margin entries on hover. On screens narrower than the lg
      breakpoint the grid collapses to a single column and the notes
      flow inline beneath their verse. %>
  <% if has_notes %>
    <% rl_on = red_letter_enabled? %>
    <% rl_attr = cookies[:red_letter].to_s.strip == "accessible" ? 'data-red-letter="accessible"' : "data-red-letter" %>
    <article class="chapter-grid <%= scripture_classes_for(@work) %>"
             lang="<%= @work.language %>"
             dir="<%= rtl_work?(@work) ? 'rtl' : 'ltr' %>"
             data-controller="annotation-highlight<%= ' word-popover' if clickable_words_unit?(@verses.first) %>"
             <%= rl_attr.html_safe if rl_on %>>
      <% note_offset = 0 %>
      <% @verses.each do |unit| %>
        <% verse_n = unit.canonical_ref.hierarchy[1] %>
        <% notes   = unit.work_unit_notes.sort_by(&:position_in_unit) %>
        <%= render "pericope_heading", pericopes: @pericope_starts[unit.canonical_ref.ord] %>
        <div class="verse-row" id="v<%= verse_n %>">
          <p class="verse-text" aria-describedby="notes-v<%= verse_n %>">
            <sup class="text-xs text-[var(--color-ink-soft)] mx-1 font-sans align-super">
              <%= link_to verse_n,
                    reader_verse_path(@work.slug, @canonical_work.slug, @chapter, verse_n),
                    class: "hover:underline decoration-dotted",
                    dir: "ltr",
                    "aria-label": "Verse #{verse_n}" %>
            </sup><%= clickable_words_unit?(unit) && notes.empty? ? render_clickable_words(unit) : render_verse_body_with_anchors(unit, notes, note_offset) %>
          </p>
          <aside class="verse-notes" id="notes-v<%= verse_n %>" aria-label="marginal notes">
            <%= render_verse_marginal_notes(notes, note_offset) %>
          </aside>
          <%= render "verse_xrefs", verse_unit: unit %>
          <%= render "verse_apparatus", verse_unit: unit %>
        </div>
        <% note_offset += notes.size %>
      <% end %>
    </article>
  <% else %>
    <% rl_on = red_letter_enabled? %>
    <% rl_attr = cookies[:red_letter].to_s.strip == "accessible" ? 'data-red-letter="accessible"' : "data-red-letter" %>
    <article class="<%= scripture_classes_for(@work) %> max-w-prose"
             lang="<%= @work.language %>"
             dir="<%= rtl_work?(@work) ? 'rtl' : 'ltr' %>"
             <% if clickable_words_unit?(@verses.first) %>data-controller="word-popover"<% end %>
             <%= rl_attr.html_safe if rl_on %>>
      <% @verses.each do |unit| %>
        <% verse_n = unit.canonical_ref.hierarchy[1] %>
        <%= render "pericope_heading", pericopes: @pericope_starts[unit.canonical_ref.ord] %>
        <p id="v<%= verse_n %>" class="mb-4">
          <sup class="text-xs text-[var(--color-ink-soft)] mx-1 font-sans align-super">
            <%= link_to verse_n,
                  reader_verse_path(@work.slug, @canonical_work.slug, @chapter, verse_n),
                  class: "hover:underline decoration-dotted",
                  dir: "ltr",
                  "aria-label": "Verse #{verse_n}" %>
          </sup><%= clickable_words_unit?(unit) ? render_clickable_words(unit) : render_body_with_red_letter(unit) %>
        </p>
        <%= render "verse_xrefs", verse_unit: unit %>
        <%= render "verse_apparatus", verse_unit: unit %>
      <% end %>
    </article>
  <% end %>

  <%
    max_ch = CanonicalRef.where(canonical_work_id: @canonical_work.id)
               .maximum(Arel.sql("hierarchy[1]")) || @chapter
    prev_ch = @chapter - 1
    next_ch = @chapter + 1
    # Find next/prev book for cross-book navigation
    all_books = CanonicalWork.joins(canonical_refs: :work_units)
                  .where(work_units: { work_id: @work.id })
                  .select("canonical_works.slug, canonical_works.position")
                  .distinct.order(:position).map(&:slug)
    book_idx = all_books.index(@canonical_work.slug)
    prev_book_slug = book_idx && book_idx > 0 ? all_books[book_idx - 1] : nil
    next_book_slug = book_idx ? all_books[book_idx + 1] : nil
  %>
  <nav aria-label="Chapter navigation" class="mt-10 flex justify-between text-sm font-serif">
    <% if prev_ch > 0 %>
      <%= link_to "← Chapter #{prev_ch}", reader_chapter_path(@work.slug, @canonical_work.slug, prev_ch),
            class: "text-[var(--color-link)] hover:underline" %>
    <% elsif prev_book_slug %>
      <% prev_cw = CanonicalWork.find_by(slug: prev_book_slug) %>
      <% prev_max = CanonicalRef.where(canonical_work_id: prev_cw.id).maximum(Arel.sql("hierarchy[1]")) %>
      <%= link_to "← #{prev_cw.display_title} #{prev_max}", reader_chapter_path(@work.slug, prev_book_slug, prev_max),
            class: "text-[var(--color-link)] hover:underline" %>
    <% else %><span></span><% end %>

    <% if next_ch <= max_ch %>
      <%= link_to "Chapter #{next_ch} →", reader_chapter_path(@work.slug, @canonical_work.slug, next_ch),
            class: "text-[var(--color-link)] hover:underline" %>
    <% elsif next_book_slug %>
      <% next_cw = CanonicalWork.find_by(slug: next_book_slug) %>
      <%= link_to "#{next_cw.display_title} 1 →", reader_chapter_path(@work.slug, next_book_slug, 1),
            class: "text-[var(--color-link)] hover:underline" %>
    <% else %><span></span><% end %>
  </nav>

  <footer class="mt-16 pt-6 border-t border-[var(--color-rule)] text-xs text-[var(--color-ink-soft)] space-y-2">
    <p>
      <%= @work.title %>
      <% if @work.license %>
        · <%= @work.license.name %>
        <% if @work.source_url %>
          · <%= link_to "source", @work.source_url, class: "underline decoration-dotted" %>
        <% end %>
      <% end %>
    </p>
    <%= render "xref_picker" %>
  </footer>
</div>
