<%# Reader settings — cross-references + red-letter color.
    Both stored as cookies, applied via Stimulus controllers. %>

<%# --- Cross-references --- %>
<% selected = current_xref_datasets %>
<% available = available_xref_datasets %>
<% if available.any? %>
  <details class="text-xs font-serif text-[var(--color-ink-soft)]"
           data-controller="xref-picker"
           <%= "open" if selected.any? %>>
    <summary class="cursor-pointer hover:text-[var(--color-ink)] select-none">
      Cross-references<% if selected.any? %>: <span class="not-italic"><%= selected.size %> active</span><% else %>: <span class="italic">off</span><% end %>
      <span class="font-sans">▾</span>
    </summary>
    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
      <% available.each do |slug| %>
        <% checked = selected.include?(slug) %>
        <label class="cursor-pointer flex items-center gap-1.5">
          <input type="checkbox" value="<%= slug %>"
                 <%= "checked" if checked %>
                 data-action="change->xref-picker#toggle"
                 class="accent-[var(--color-ink)]" />
          <span><%= xref_dataset_label(slug) %></span>
        </label>
      <% end %>
    </div>
  </details>
<% end %>

<%# --- Red-letter / words of Christ --- %>
<% if @work.has_red_letter? %>
  <% rl_mode = cookies[:red_letter].to_s %>
  <% rl_on = %w[on accessible].include?(rl_mode) %>
  <div class="text-xs font-serif text-[var(--color-ink-soft)] flex items-center gap-x-3 flex-wrap"
       data-controller="red-letter">
    <label class="cursor-pointer flex items-center gap-1.5">
      <input type="checkbox" name="red_letter" value="on"
             <%= "checked" if rl_on %>
             data-action="change->red-letter#apply"
             class="accent-[var(--color-ink)]" />
      <span>Words of Christ</span>
    </label>
    <label class="cursor-pointer flex items-center gap-1.5 <%= 'hidden' unless rl_on %>"
           data-red-letter-target="underlineLabel">
      <input type="checkbox" name="red_letter_underline" value="accessible"
             <%= "checked" if rl_mode == "accessible" %>
             data-action="change->red-letter#toggleUnderline"
             class="accent-[var(--color-ink)]" />
      <span>also underline</span>
    </label>
  </div>
<% end %>

<%# --- Apparatus toggle --- %>
<% if @show_apparatus %>
  <% app_on = cookies[:apparatus].to_s == "on" %>
  <div class="text-xs font-serif text-[var(--color-ink-soft)] flex items-center gap-x-3 flex-wrap">
    <label class="cursor-pointer flex items-center gap-1.5">
      <input type="checkbox" name="apparatus" value="on"
             <%= "checked" if app_on %>
             data-action="change->xref-picker#toggleApparatus"
             class="accent-[var(--color-ink)]" />
      <span>Critical apparatus</span>
    </label>
  </div>
<% end %>
