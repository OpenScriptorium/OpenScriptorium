<%# Pericope section heading.
    Rendered just above any verse where one or more pericopes begin.
    Receives `pericopes:` — an array of Pericope rows whose
    canonical_range starts at the current verse's ord (or nil/empty
    when nothing starts here).

    For Hebrew works (WLC, etc.) we show only the Hebrew name.
    For English/other works (JPS 1917, future LXX/Brenton parallels)
    we show the English transliteration.

    The type ("pericope" / "section" / "heading" / "parashah") is
    encoded only by visual hierarchy — type label text was too noisy.
    The type is exposed via `title=` and `aria-label` for accessibility
    and hover affordance. %>
<% show_hebrew_only = @work&.language == "he" %>
<%
  type_classes = {
    "section"   => { wrap: "mt-10 mb-4", text: "text-lg",  weight: "font-semibold", glyph: "§" },
    "pericope"  => { wrap: "mt-8 mb-3",  text: "text-base", weight: "font-medium",   glyph: "¶" },
    "parashah"  => { wrap: "mt-8 mb-3",  text: "text-base", weight: "font-medium",   glyph: "¶" },
    "haftarah"  => { wrap: "mt-8 mb-3",  text: "text-base", weight: "font-medium",   glyph: "¶" },
    "lectionary" => { wrap: "mt-6 mb-3", text: "text-base", weight: "font-medium",   glyph: "¶" },
    "heading"   => { wrap: "mt-5 mb-2",  text: "text-sm",   weight: "font-normal italic", glyph: "›" }
  }
%>
<% Array(pericopes).each do |p| %>
  <% s = type_classes[p.pericope_type] || type_classes["pericope"] %>
  <% range = pericope_range_label(p) %>
  <% heading_tag = case p.pericope_type
                    when "section"    then "h2"
                    when "heading"    then "h4"
                    else "h3"
                    end %>
  <div class="<%= s[:wrap] %> first:mt-0 col-span-full font-serif">
    <<%= heading_tag %> class="<%= s[:text] %> <%= s[:weight] %> text-[var(--color-ink)] flex items-baseline gap-x-2 flex-wrap"
       aria-label="<%= p.pericope_type.humanize %>: <%= p.name %>">
      <span class="text-[var(--color-ink-soft)] font-normal not-italic select-none" aria-hidden="true"><%= s[:glyph] %></span>
      <% if show_hebrew_only && p.native_name.present? %>
        <span class="font-hebrew" lang="he" dir="rtl"><%= p.native_name %></span>
      <% else %>
        <span><%= p.name %></span>
      <% end %>
      <% if range %>
        <span class="text-xs font-normal not-italic text-[var(--color-ink-soft)]"><%= range %></span>
      <% end %>
    </<%= heading_tag %>>
  </div>
<% end %>
